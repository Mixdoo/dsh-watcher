# Optional Harness checkout. Needed only when tools/client-build.js is missing.
DSHX_HARNESS=

# Opt-in browser acceptance against a Host that is already running.
# Hostname must be 127.0.0.1, localhost, or [::1]. The startup token, if any, stays in this URL.
DSH_TEST_URL=
DSH_TEST_WORKSPACE=
DSH_TEST_SESSION=

# Optional fixtures for tests/golden-replay.test.mjs. The test skips when this is unset.
WATCHER_GOLDEN_DIR=
